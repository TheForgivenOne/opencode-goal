{
  "name": "opencode-goal",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode V2 /goal plugin — an autonomous goal-directed loop (server + TUI halves).",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "rpc.ts",
    "core/*.ts",
    "tui/*.ts",
    "tui/*.tsx",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "test": "bun test ./",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5"
  }
}
